<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="GeoNetwork Test Plan">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Base Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASEDIR" elementType="Argument">
            <stringProp name="Argument.name">BASEDIR</stringProp>
            <stringProp name="Argument.value">${__BeanShell(import org.apache.jmeter.services.FileServer; FileServer.getFileServer().getBaseDir();,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="METADATAXML" elementType="Argument">
            <stringProp name="Argument.name">METADATAXML</stringProp>
            <stringProp name="Argument.value">${__FileToString(${BASEDIR}/data/iso19139_sample_metadata.xml,UTF-8)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">raw xml for the metadata edit tests.  Contains some variables for expanding</stringProp>
          </elementProp>
          <elementProp name="SEARCH_ALL_REQUEST" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_ALL_REQUEST</stringProp>
            <stringProp name="Argument.value">${__FileToString(${BASEDIR}/data/search_all.json,,)}</stringProp>
            <stringProp name="Argument.desc"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NUMBER_OF_THREADS" elementType="Argument">
            <stringProp name="Argument.name">NUMBER_OF_THREADS</stringProp>
            <stringProp name="Argument.value">10</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NUMBER_OF_LOOP" elementType="Argument">
            <stringProp name="Argument.name">NUMBER_OF_LOOP</stringProp>
            <stringProp name="Argument.value">10</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="GN_INDEX" elementType="Argument">
            <stringProp name="Argument.name">GN_INDEX</stringProp>
            <stringProp name="Argument.value">gn-records</stringProp>
            <stringProp name="Argument.desc"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <stringProp name="HTTPSampler.domain">${__P(testserver.host,metawal.test.wallonie.be)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(testserver.port,443)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(testserver.protocol,https)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation"></stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Add content type">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">content-type</stringProp>
            <stringProp name="Header.value">application/json;charset=UTF-8 </stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="API Free Text Search">
        <stringProp name="ThreadGroup.num_threads">${NUMBER_OF_THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">${NUMBER_OF_LOOP}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="API Search endpoint"/>
        <hashTree>
          <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="5 requests a second Timer">
            <doubleProp>
              <name>throughput</name>
              <value>300.0</value>
              <savedValue>0.0</savedValue>
            </doubleProp>
            <intProp name="calcMode">1</intProp>
          </ConstantThroughputTimer>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Search all and check total hits">
            <stringProp name="HTTPSampler.path">${__P(base.loc.url, /geonetwork/srv)}/api/search/records/_search?bucket=metadata</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;from&quot;:0,&quot;size&quot;:80,&quot;query&quot;:{&quot;function_score&quot;:{&quot;boost&quot;:5,&quot;score_mode&quot;:&quot;multiply&quot;,&quot;functions&quot;:[{&quot;filter&quot;:{&quot;exists&quot;:{&quot;field&quot;:&quot;parentUuid&quot;}},&quot;weight&quot;:0.3},{&quot;filter&quot;:{&quot;match&quot;:{&quot;cl_status.key&quot;:&quot;obsolete&quot;}},&quot;weight&quot;:0.2},{&quot;filter&quot;:{&quot;match&quot;:{&quot;cl_status.key&quot;:&quot;superseded&quot;}},&quot;weight&quot;:0.3},{&quot;gauss&quot;:{&quot;changeDate&quot;:{&quot;scale&quot;:&quot;365d&quot;,&quot;offset&quot;:&quot;90d&quot;,&quot;decay&quot;:0.5}}}],&quot;query&quot;:{&quot;bool&quot;:{&quot;must&quot;:[{&quot;multi_match&quot;:{&quot;query&quot;:&quot;parcelaire&quot;,&quot;type&quot;:&quot;bool_prefix&quot;,&quot;fields&quot;:[&quot;resourceTitleObject.langfre^6&quot;,&quot;resourceAbstractObject.langfre^.5&quot;,&quot;tag&quot;,&quot;uuid&quot;,&quot;resourceIdentifier&quot;]}},{&quot;terms&quot;:{&quot;isTemplate&quot;:[&quot;n&quot;]}}],&quot;filter&quot;:[{&quot;query_string&quot;:{&quot;query&quot;:&quot;infrasig_WalOnMap:true&quot;}}]}}}},&quot;_source&quot;:{&quot;includes&quot;:[&quot;resourceTitleObject.default&quot;,&quot;overview.url&quot;,&quot;uuid&quot;,&quot;resourceHookAbstractObject.default&quot;,&quot;linkUrlProtocolESRIREST&quot;,&quot;linkUrlProtocolOGCWMS&quot;,&quot;cl_resourceScope.key*&quot;,&quot;th_Themes_geoportail_wallon_hierarchy_tree.default*&quot;]}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion">
              <stringProp name="DurationAssertion.duration">1000</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON Assertion">
              <stringProp name="JSON_PATH">$.hits.total.value</stringProp>
              <stringProp name="EXPECTED_VALUE">\d+</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">true</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="API Search - categories available">
        <stringProp name="ThreadGroup.num_threads">${NUMBER_OF_THREADS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
