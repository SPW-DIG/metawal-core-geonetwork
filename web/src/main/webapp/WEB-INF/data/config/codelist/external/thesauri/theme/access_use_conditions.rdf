<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
	<skos:ConceptScheme rdf:about="https://metawal.wallonie.be/thesaurus/conditions">
		<dc:title>Conditions d'utilisation et d'accès, version 2.0</dc:title>
		<dc:description>Conditions d'utilisation et d'accès - Metawal</dc:description>
		<dc:creator>
			<foaf:Organization>
				<foaf:name>SPW - DIG</foaf:name>
			</foaf:Organization>
		</dc:creator>
		<dcterms:issued>2019-09-24</dcterms:issued>
		<dcterms:modified>2021-01-19</dcterms:modified>
	</skos:ConceptScheme>
	<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/ConditionsApplyingToAccessAndUse/noConditionsApply">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">No limitations to public access and use</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Il n'y a pas de limitation d'accès ni de limitation d'utilisation pour cette donnée.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Pas de limitation d'accès public à cette donnée.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">L'accès à cette donnée n'est pas limité à un public particulier.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CGA.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CGA SPW : La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elle couvre et pour toute finalité.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et pour toute finalité.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CGU.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CGU SPW : L’Utilisateur ne peut pas redistribuer les données à un tiers ni publier les données sur Internet via un service web. L'utilisateur peut publier les données sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeA1.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type A1 SPW : La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent pour toute finalité autre que commerciale.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type A1.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeB2.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type B2 SPW : La donnée n’est accessible qu’aux partenaires liés au SPW par une convention cosignée pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et pour toute finalité.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type B2.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeD1.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type D1 SPW : La donnée n’est accessible gratuitement que pour les services publics (commune, province, communautés et régions belges, fédéral, Intercommunale, police, services d’incendie, OIP, et leurs équivalents étrangers) et les soumissionnaires ou adjudicataires dans le cadre d'un marché public lancé par les services publics susmentionnés, ou pour l’enseignement et la recherche académique sans but lucratif. La donnée n’est accessible que pendant la durée du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est distribuée que sur l’étendue de la zone d’intérêt du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est accessible que pour la finalité du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type D1.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeA.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPU Type A SPW : L’Utilisateur ne peut pas redistribuer la donnée à un tiers. L’Utilisateur est autorisé à publier la donnée sur Internet via un service web ou sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.). L’Utilisateur indique la mention « Sources des données : Service public de Wallonie » ou « Sources des données : SPW » sur tout document et sur toute carte issus de la donnée qu’il publie, à moins qu’une mention particulière soit mentionnée dans la Fiche descriptive de la donnée. Dans la mesure du possible, la mention comporte un hyperlien vers http://geoportail.wallonie.be</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent mais sont restreintes par les conditions particulières de type A.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeB.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPU Type B SPW : L’Utilisateur ne peut pas redistribuer la donnée à un tiers ni la publier sur Internet via un service web ni sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent mais sont restreintes ou étendues par les conditions particulières de type B</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeC.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPU Type C SPW : L’Utilisateur peut redistribuer la donnée à un tiers, publier la donnée sur Internet via un service web ou sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent et sont étendues par les conditions particulières de type C.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://opendatacommons.org/licenses/odbl/1-0/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Licence ODbL v1.0 : L’utilisateur peut partager, adapter et dériver une œuvre de ces données. Il peut publier les données initiales, les données dérivées et l’œuvre dérivée à condition de citer les sources (attribution), de le faire sous la licence ODbL (share alike). Il est autorisé à utiliser des moyens technologique de restriction d'accès (DRM) pour autant qu'une version non restreinte soit aussi distribuée.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Licence ODbL v1.0. Cette licence est à utiliser pour toute donnée exploitant des données sous licence ODbL, comme par exemple les données OpenStreetMap</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://creativecommons.org/licenses/by/4.0/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Licence CC-BY 4.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Licence CC-BY 4.0 : licence ouverte avec obligation d'attribution.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://creativecommons.org/publicdomain/zero/1.0/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Licence CC0 1.0 : Les données sont dans le domaine public. L’utilisateur peut librement copier, modifier, redistribuer et dériver une oeuvre de ces données.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Licence CC0 1.0 : domaine public.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://creativecommons.org/licenses/by-nc/4.0/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Licence CC-BY-NC 4.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources. L'usage commercial des données, des données dérivées ou de l'oeuvre dérivée est interdit.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Licence CC-BY-NC 4.0 : licence ouverte avec obligation d'attribution et interdiction d'usage commercial.</skos:scopeNote>
	</rdf:Description>


<!--	 Types de CAU qui ne sont pas / plus utilisés dans Metawal

	<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/ConditionsApplyingToAccessAndUse/conditionsUnknown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">Conditions d'accès et d'utilisation inconnues.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions d'accès et d'utilisation sont inconnues</skos:scopeNote>
	</rdf:Description>
    <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeB1.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type B1 SPW : La donnée est accessible par toute personne physique ou morale avec des restrictions de durée, de couverture territoriale et de finalité à convenir entre l’Utilisateur et le Gestionnaire de la donnée à travers une Licence d’utilisation. La donnée peut ne pas être gratuite.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type B1.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeC1.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type C1 SPW : La donnée n’est accessible que pour les Zones de police et les Communes (collège communal), pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et uniquement à des fins d’étude.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type C1.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeC2.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type C2 SPW : La donnée n’est accessible que pour des agents internes au SPW-MI – Routes et Bâtiments du SPW, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et uniquement à des fins d’étude.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type C2.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeC3.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type C3 SPW : L’accès à la donnée est conditionné à une demande transmise par le demandeur au Helpdesk carto du SPW (helpdesk.carto@spw.wallonie.be). Cette demande sera automatique soumise au gestionnaire de la donnée dont l'accord est requis pour la délivrance, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et uniquement à des fins d’étude.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type C3.</skos:scopeNote>
	</rdf:Description>
	<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeD2.pdf">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="fr">CPA Type D1 SPW : La donnée n’est accessible que pour les compagnies d’assurance, gratuitement et que pendant la durée du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est distribuée que sur l’étendue de la zone d’intérêt du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est accessible que pour la finalité du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation.</skos:prefLabel>
		<skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type D2.</skos:scopeNote>
	</rdf:Description>

-->

</rdf:RDF>
