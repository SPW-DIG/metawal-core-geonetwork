<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <skos:ConceptScheme rdf:about="https://metawal.wallonie.be/thesaurus/conditions">
    <dc:title>Conditions d'utilisation et d'accès, version 2.0</dc:title>
    <dc:description>Conditions d'utilisation et d'accès - Metawal</dc:description>
    <dc:creator>
      <foaf:Organization>
        <foaf:name>SPW - DIG</foaf:name>
      </foaf:Organization>
    </dc:creator>
    <dcterms:issued>2019-09-24</dcterms:issued>
    <dcterms:modified>2025-09-10</dcterms:modified>
  </skos:ConceptScheme>
  <!--	 CAU spécifiques SPW -->
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CGA.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CGA SPW : La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elle couvre et pour toute finalité.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et pour toute finalité.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CGU.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CGU SPW : L’Utilisateur ne peut pas redistribuer les données à un tiers ni publier les données sur Internet via un service web. L'utilisateur peut publier les données sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeA1.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPA Type A1 SPW : La donnée est accessible par toute personne physique ou morale, pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent pour toute finalité autre que commerciale.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type A1.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeB2.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPA Type B2 SPW : La donnée n’est accessible qu’aux partenaires liés au SPW par une convention cosignée pour une durée indéterminée, gratuitement, sur l’entièreté du territoire qu’elles couvrent et pour toute finalité.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type B2.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPA-TypeD1.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPA Type D1 SPW : La donnée n’est accessible gratuitement que pour les services publics (commune, province, communautés et régions belges, fédéral, Intercommunale, police, services d’incendie, OIP, et leurs équivalents étrangers) et les soumissionnaires ou adjudicataires dans le cadre d'un marché public lancé par les services publics susmentionnés, ou pour l’enseignement et la recherche académique sans but lucratif. La donnée n’est accessible que pendant la durée du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est distribuée que sur l’étendue de la zone d’intérêt du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation. La donnée n’est accessible que pour la finalité du projet ou de la mission convenue entre l’Utilisateur et le Gestionnaire de la donnée et telle que reprise dans la Licence d’utilisation.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'accès s’appliquent mais sont restreintes ou étendues par les conditions particulières de type D1.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeA.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPU Type A SPW : L’Utilisateur ne peut pas redistribuer la donnée à un tiers. L’Utilisateur est autorisé à publier la donnée sur Internet via un service web ou sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.). L’Utilisateur indique la mention « Sources des données : Service public de Wallonie » ou « Sources des données : SPW » sur tout document et sur toute carte issus de la donnée qu’il publie, à moins qu’une mention particulière soit mentionnée dans la Fiche descriptive de la donnée. Dans la mesure du possible, la mention comporte un hyperlien vers http://geoportail.wallonie.be</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent mais sont restreintes par les conditions particulières de type A.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeB.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPU Type B SPW : L’Utilisateur ne peut pas redistribuer la donnée à un tiers ni la publier sur Internet via un service web ni sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent mais sont restreintes ou étendues par les conditions particulières de type B</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/DataSPW-CPU-TypeC.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">CPU Type C SPW : L’Utilisateur peut redistribuer la donnée à un tiers, publier la donnée sur Internet via un service web ou sur support statique (carte papier, brochure, support de présentation orale, pdf ou image sur Internet, rapport, etc.).</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Les conditions générales d'utilisation s'appliquent et sont étendues par les conditions particulières de type C.</skos:scopeNote>
  </rdf:Description>
  
  <!--	 Licences ouvertes -->
  <rdf:Description rdf:about="https://opendatacommons.org/licenses/odbl/1-0/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence ODbL v1.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources (attribution) et de le faire sous la licence ODbL (share alike). Une traduction non-officielle de la licence ODbL est disponible à l'adresse https://mobilite.wallonie.be/files/ODbL-fr.pdf</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence ODbL v1.0. Cette licence est à utiliser pour toute donnée exploitant des données sous licence ODbL, comme par exemple les données OpenStreetMap</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">ODbL-licentie v1.0: De gebruiker mag de gegevens gebruiken en wijzigen om er een afgeleid werk van te maken. Hij mag de gegevens en het afgeleide werk publiceren op voorwaarde dat hij de bronnen vermeldt (naamsvermelding) en dit doet onder de ODbL-licentie (share alike).</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">ODbL-licentie v1.0. Deze licentie moet worden gebruikt voor alle gegevens die gebruikmaken van gegevens onder de ODbL-licentie, zoals bijvoorbeeld OpenStreetMap-gegevens.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://creativecommons.org/licenses/by/4.0/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence CC-BY 4.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence CC-BY 4.0 : licence ouverte avec obligation d'attribution.</skos:scopeNote>
	<skos:prefLabel xml:lang="nl">CC‑BY 4.0‑licentie: De gebruiker mag de gegevens gebruiken en wijzigen om er een afgeleid werk van te maken. Hij mag de gegevens en het afgeleide werk publiceren op voorwaarde dat hij de bronnen vermeldt.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">CC‑BY 4.0‑licentie: open licentie met verplichting tot naamsvermelding.</skos:scopeNote>
  </rdf:Description>
<rdf:Description rdf:about="https://creativecommons.org/publicdomain/zero/1.0/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence CC0 1.0 : Les données sont dans le domaine public. L’utilisateur peut librement copier, modifier, redistribuer et dériver une oeuvre de ces données.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence CC0 1.0 : domaine public.</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">CC0 1.0-licentie: De gegevens behoren tot het publieke domein. De gebruiker mag deze vrij kopiëren, wijzigen, herdistribueren en er een afgeleid werk van maken.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">CC0 1.0-licentie: publiek domein.</skos:scopeNote>
</rdf:Description>
<rdf:Description rdf:about="https://creativecommons.org/licenses/by-nc/4.0/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence CC-BY-NC 4.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources. L'usage commercial des données, des données dérivées ou de l'oeuvre dérivée est interdit.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence CC-BY-NC 4.0 : licence ouverte avec obligation d'attribution et interdiction d'usage commercial.</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">CC-BY-NC 4.0-licentie: De gebruiker mag de gegevens gebruiken en wijzigen om er een afgeleid werk van te maken. Hij mag de gegevens en het afgeleide werk publiceren op voorwaarde dat hij de bronnen vermeldt. Commercieel gebruik van de gegevens, afgeleide gegevens of het afgeleide werk is verboden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">CC-BY-NC 4.0-licentie: open licentie met verplichting tot naamsvermelding en verbod op commercieel gebruik.</skos:scopeNote>
</rdf:Description>
<rdf:Description rdf:about="https://creativecommons.org/licenses/by-sa/4.0/">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence CC-BY-SA 4.0 : L’utilisateur peut utiliser et modifier les données pour en dériver une œuvre. Il peut publier les données et l’œuvre dérivée à condition de citer les sources et de les partager avec la même licence que les données originales.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence CC-BY-SA 4.0 : licence ouverte avec obligation d'attribution et partage dans les mêmes conditions.</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">CC-BY-SA 4.0-licentie: De gebruiker mag de gegevens gebruiken en wijzigen om er een afgeleid werk van te maken. Hij mag de gegevens en het afgeleide werk publiceren op voorwaarde dat hij de bronnen vermeldt en deze onder dezelfde licentie deelt als de oorspronkelijke gegevens.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">CC-BY-SA 4.0-licentie: open licentie met verplichting tot naamsvermelding en delen onder dezelfde voorwaarden.</skos:scopeNote>
</rdf:Description>
  <!--	 Codes spécifiques INSPIRE -->
  <rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Pas de limitation d'accès public à cette donnée.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">L'accès à cette donnée n'est pas limité à un public particulier.</skos:scopeNote>
	    <skos:prefLabel xml:lang="fr">Geen beperking van de publieke toegang tot deze gegevens.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">De toegang tot deze gegevens is niet beperkt tot een specifiek publiek.</skos:scopeNote>
  </rdf:Description>
<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/ConditionsApplyingToAccessAndUse/noConditionsApply">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">No limitations to public access and use</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Il n'y a pas de limitation d'accès ni de limitation d'utilisation pour cette donnée.</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">Geen beperkingen op publieke toegang en gebruik</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Er zijn geen beperkingen op toegang of gebruik van deze gegevens.</skos:scopeNote>
</rdf:Description>

  <!--	 Codes spécifiques aux services -->
  <rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Les services sont librement accessibles.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Tout le monde peut accéder à ce service.</skos:scopeNote>
	    <skos:prefLabel xml:lang="nl">De diensten zijn vrij toegankelijk.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Iedereen kan toegang krijgen tot deze dienst.</skos:scopeNote>
  </rdf:Description>
<rdf:Description rdf:about="https://geoportail.wallonie.be/files/documents/ConditionsSPW/LicServicesSPW.pdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">Licence de webservice SPW : Les conditions d'utilisation du service sont régies par les Conditions d’accès et d’utilisation des services web géographiques du Service public de Wallonie. L’utilisateur n’appelle pas les services de manière disproportionnée ou inadaptée.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Licence de webservice SPW : licence d'utilisation ouverte</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">SPW-webservicelicentie: De gebruiksvoorwaarden van de dienst worden geregeld door de voorwaarden voor toegang en gebruik van de geografische webdiensten van de Service public de Wallonie. De gebruiker roept de diensten niet op een disproportionele of onaangepaste manier aan.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">SPW-webservicelicentie: open gebruikslicentie</skos:scopeNote>
</rdf:Description>
  <!--	 Justification des accès retreints -->
<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1a">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire à la confidentialité des délibérations et travaux des autorités publiques.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Confidentialité des travaux des autorités publiques.</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de vertrouwelijkheid van beraadslagingen en werkzaamheden van overheidsinstanties kan schaden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Vertrouwelijkheid van werkzaamheden van overheidsinstanties.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1b">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire aux relations internationales, à la défense nationale ou à la sécurité publique, y compris la protection des infrastructures critiques.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Relations internationales, défense nationale ou sécurité publique</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de internationale betrekkingen, de nationale defensie of de openbare veiligheid kan schaden, met inbegrip van de bescherming van kritieke infrastructuren.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Internationale betrekkingen, nationale defensie of openbare veiligheid.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire à la bonne marche de la justice, à la possibilité pour toute personne d'être jugée équitablement ou à la capacité d'une autorité publique d'effectuer une enquête d'ordre pénal ou disciplinaire.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Bonne marche de la justice</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de goede rechtsgang kan schaden, het recht op een eerlijk proces kan aantasten of het vermogen van een overheidsinstantie om een strafrechtelijk of disciplinair onderzoek uit te voeren kan belemmeren.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Goede rechtsgang.</skos:scopeNote>
</rdf:Description>
<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire à la confidentialité des informations commerciales ou industrielles.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Secret des affaires</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de vertrouwelijkheid van commerciële of industriële informatie kan schaden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Bedrijfsgeheimen.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint conformément au principe de confidentialité des unités statistiques individuelles.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Secret statistique</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt overeenkomstig het principe van vertrouwelijkheid van individuele statistische eenheden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Statistisch geheim.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1e">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L'accès est restreint en raison de droits d’auteur ou de brevets détenus par des tiers qui n'autorisent pas la divulgation des données.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Droits de propriété intellectuelle tiers</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt wegens auteursrechten of octrooien van derden die de openbaarmaking van de gegevens niet toestaan.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Intellectuele eigendomsrechten van derden.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1f">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car les données contiennent des informations à caractère personnel pour lesquelles il n'existe pas d'autorisation de divulgation au public.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Données personnelles</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat de gegevens persoonsgegevens bevatten waarvoor geen toestemming voor openbaarmaking bestaat.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Persoonsgegevens.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1g">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire aux intérêts ou à la protection de personnes ayant fourni des informations sur base volontaire pour dénoncer un fait punissable ou supposé tel.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Protection des lanceurs d'alerte</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de belangen of de bescherming kan schaden van personen die vrijwillig informatie hebben verstrekt om een strafbaar feit te melden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Bescherming van klokkenluiders.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1h">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L’accès est restreint car la divulgation des données pourrait nuire à la protection de l'environnement, des espèces ou des habitats vulnérables.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Données environnementales sensibles</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat openbaarmaking van de gegevens de bescherming van het milieu, soorten of kwetsbare habitats kan schaden.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Gevoelige milieugegevens.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/INSPIRE_Directive_Article13_1d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L'accès est restreint suite à une obligation de secret ou de confidentialité imposée à l'organisme public en vertu d'une convention ou d'un engagement contractuel.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Restriction contractuelle</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt wegens een verplichting tot geheimhouding of vertrouwelijkheid die aan de overheidsinstantie is opgelegd via een overeenkomst of contractuele verbintenis.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Contractuele beperking.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="http://publications.europa.eu/resource/authority/confidentiality-level/OP_DATPRO">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <skos:prefLabel xml:lang="fr">L'accès est restreint car la donnée n'est pas encore finalisée.</skos:prefLabel>
    <skos:scopeNote xml:lang="fr">Données provisoires</skos:scopeNote>
    <skos:prefLabel xml:lang="nl">De toegang is beperkt omdat de gegevens nog niet definitief zijn.</skos:prefLabel>
    <skos:scopeNote xml:lang="nl">Voorlopige gegevens.</skos:scopeNote>
</rdf:Description>
