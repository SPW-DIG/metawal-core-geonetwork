    <skos:prefLabel xml:lang="ga">Sonraí ó fheidhmchláir folláine</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни от уелнес приложения</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци од апликации за благосостојба</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tiedot hyvinvointisovelluksista</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Data z wellness aplikací</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok wellness alkalmazásokból</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje z wellness aplikácií</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys iš sveikatingumo programėlių</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci iz wellness aplikacija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Data från wellness-applikationer</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Donnéeën aus Wellness-Applikatiounen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens van wellness-applicaties</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten aus Wellness-Anwendungen</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα από εφαρμογές ευεξίας</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
