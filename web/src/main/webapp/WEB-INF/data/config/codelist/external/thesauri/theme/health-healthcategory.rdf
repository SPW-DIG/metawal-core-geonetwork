  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HGPD">
    <dct:identifier>HGPD</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="ga">Sonraí géiniteacha, epigeanómacha agus géanómacha daonna</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Menschliche genetische, epigenomische und genomische Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Ihmisen geneettiset, epigenomiset ja genomiset tiedot</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Human genetic, epigenomic and genomic data</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date genetice, epigenomice și genomice umane</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Menneskelige genetiske, epigenomiske og genomiske data</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados genéticos, epigenómicos e genómicos humanos</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Генетски, епигеномски и геномски податоци за луѓето</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Emberi genetikai, epigenomikai és genomikai adatok</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Žmogaus genetiniai, epigenominiai ir genomikai duomenys</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Inimese geneetilised, epigenoomilised ja genoomilised andmed</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos genéticos, epigenómicos y genómicos humanos</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="sk">Ľudské genetické, epigenomické a genomické údaje</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Mënschlech genetesch, epigenomesch a genomesch Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta ġenetika, epigenomika u genomika tal-bniedem</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati genetici, epigenomici e genomici umani</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Genetische, epigenomische en genomische gegevens van de mens</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Ludzkie dane genetyczne, epigenomiczne i genomiczne</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Cilvēka ģenētiskie, epigenomiskie un genomiskie dati</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données génétiques, épigénomiques et génomiques humaines</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna gjenetike, epigjenomike dhe gjenomike njerëzore</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Mänskliga genetiska, epigenomiska och genomiska data</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Ανθρώπινα γενετικά, επιγενετικά και γονιδιωματικά δεδομένα</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Човешки генетични, епигеномни и геномни данни</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Genetski, epigenomski i genomski podaci o ljudima</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Lidská genetická, epigenomická a genomická data</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Človeški genetski, epigenomski in genomski podatki</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/PHDR">

<dct:identifier>PHDR</dct:identifier>
<skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
<skos:prefLabel xml:lang="cs">Registry zdravotních údajů založené na populaci (registry veřejného zdraví)</skos:prefLabel>
<skos:prefLabel xml:lang="fi">Väestöpohjaiset terveystietorekisterit (kansanterveysrekisterit)</skos:prefLabel>
<skos:prefLabel xml:lang="et">Rahvastikupõhised terviseandmete registrid (rahvatervise registrid)</skos:prefLabel>
<skos:prefLabel xml:lang="pt">Registos de dados de saúde baseados na população (registos de saúde pública)</skos:prefLabel>
<skos:prefLabel xml:lang="lb">Populatiounsbaséiert Gesondheetsdatenregister (Register fir d'ëffentlech Gesondheet)</skos:prefLabel>
<skos:prefLabel xml:lang="fr">Registres de données de santé basés sur la population (registres de santé publique)</skos:prefLabel>
<skos:prefLabel xml:lang="lt">Gyventojų sveikatos duomenų registrai (visuomenės sveikatos registrai)</skos:prefLabel>
<skos:prefLabel xml:lang="sl">Registri zdravstvenih podatkov, ki temeljijo na prebivalstvu (registri javnega zdravja)</skos:prefLabel>
<skos:prefLabel xml:lang="mk">Регистри на здравствени податоци базирани на населението (регистри за јавно здравје)</skos:prefLabel>
<skos:prefLabel xml:lang="sq">Regjistrat e të dhënave shëndetësore të bazuara në popullatë (regjistrat e shëndetit publik)</skos:prefLabel>
<skos:prefLabel xml:lang="de">Bevölkerungsbezogene Gesundheitsdatenregister (Register der öffentlichen Gesundheit)</skos:prefLabel>
<skos:prefLabel xml:lang="el">Μητρώα δεδομένων υγείας που βασίζονται στον πληθυσμό (μητρώα δημόσιας υγείας)</skos:prefLabel>
<skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
<skos:prefLabel xml:lang="sv">Befolkningsbaserade hälsodataregister (folkhälsoregister)</skos:prefLabel>
<skos:prefLabel xml:lang="nl">Bevolkingsgebonden gezondheidsgegevensregisters (volksgezondheidsregisters)</skos:prefLabel>
<skos:prefLabel xml:lang="pl">Rejestry danych zdrowotnych oparte na populacji (rejestry zdrowia publicznego)</skos:prefLabel>
<skos:prefLabel xml:lang="lv">Ar iedzīvotājiem saistītu veselības datu reģistri (sabiedrības veselības reģistri)</skos:prefLabel>
<skos:prefLabel xml:lang="bg">Регистри на здравни данни, базирани на населението (регистри за обществено здраве)</skos:prefLabel>
<skos:prefLabel xml:lang="it">Registri di dati sanitari basati sulla popolazione (registri di sanità pubblica)</skos:prefLabel>
<skos:prefLabel xml:lang="hr">Registar zdravstvenih podataka temeljen na populaciji (registri javnog zdravlja)</skos:prefLabel>
<skos:prefLabel xml:lang="ga">Clárlanna sonraí sláinte atá bunaithe ar an daonra (clárlanna sláinte poiblí)</skos:prefLabel>
<skos:prefLabel xml:lang="en">Data from population-based health data registries such as public health registries</skos:prefLabel>
<skos:prefLabel xml:lang="ro">Registre de date de sănătate bazate pe populație (registre de sănătate publică)</skos:prefLabel>
<skos:prefLabel xml:lang="hu">Népességalapú egészségügyi adatregiszterek (közegészségügyi nyilvántartások)</skos:prefLabel>
<skos:prefLabel xml:lang="da">Befolkningsbaserede sundhedsdataregistre (folkesundhedsregistre)</skos:prefLabel>
<skos:prefLabel xml:lang="sk">Registre zdravotných údajov založené na populácii (registre verejného zdravia)</skos:prefLabel>
<skos:prefLabel xml:lang="mt">Reġistri tad-dejta tas-saħħa bbażati fuq il-popolazzjoni (reġistri tas-saħħa pubblika)</skos:prefLabel>
<skos:prefLabel xml:lang="es">Registros de datos de salud basados en la población (registros de salud pública)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EHCT">
    <dct:identifier>EHCT</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="lt">Duomenys iš klinikinių tyrimų, klinikinių tyrimų ir klinikinių tyrimų, kuriems taikomas Reglamentas (ES) 536/2014, Reglamentas [SOHO], Reglamentas (ES) 2017/745 ir Reglamentas (ES) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati no klīniskajiem pētījumiem, klīniskajiem pētījumiem un klīniskajiem pētījumiem, uz kuriem attiecas Regula (ES) 536/2014, Regula [SOHO], Regula (ES) 2017/745 un Regula (ES) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí ó thrialacha cliniciúla, ó staidéir chliniciúla agus ó imscrúduithe cliniciúla ar faoina réir atá Rialachán (AE) 536/2014, Rialachán [SOHO], Rialachán (AE) 2017/745 agus Rialachán (AE) 2017/746, faoi seach</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki iz kliničnih preskušanj, kliničnih študij in kliničnih raziskav v skladu z Uredbo (EU) št. 536/2014, Uredbo [SOHO], Uredbo (EU) št. 2017/745 in Uredbo (EU) št. 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta minn provi kliniċi, studji kliniċi u investigazzjonijiet kliniċi soġġetti għar-Regolament (UE) 536/2014, Regolament [SOHO], Regolament (UE) 2017/745 u Regolament (UE) 2017/746, rispettivament</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed kliiniliste uuringute, kliiniliste uuringute ja kliiniliste uuringute kohta, mille suhtes kohaldatakse määrust (EL) 536/2014, määrust [SOHO], määrust (EL) 2017/745 ja määrust (EL) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna nga provat klinike, studimet klinike dhe hetimet klinike që i nënshtrohen Rregullores (BE) 536/2014, Rregullores [SOHO], Rregullores (BE) 2017/745 dhe Rregullores (BE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de ensayos clínicos, estudios clínicos e investigaciones clínicas sujetos respectivamente al Reglamento (UE) 536/2014, al Reglamento [SOHO], al Reglamento (UE) 2017/745 y al Reglamento (UE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни от клинични изпитвания, клинични проучвания и клинични изследвания, подлежащи на Регламент (ЕС) 536/2014, Регламент [SOHO], Регламент (ЕС) 2017/745 и Регламент (ЕС) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok a klinikai vizsgálatokról, klinikai tanulmányokról és klinikai vizsgálatokról, amelyek az 536/2014/EU rendelet, a [SOHO] rendelet, a 2017/745/EU rendelet és a 2017/746/EU rendelet hatálya alá tartoznak</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje z klinických skúšok, klinických štúdií a klinických skúšok, na ktoré sa vzťahuje nariadenie (EÚ) 536/2014, nariadenie [SOHO], nariadenie (EÚ) 2017/745 a nariadenie (EÚ) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens uit klinische proeven, klinische studies en klinische onderzoeken die respectievelijk onder Verordening (EU) 536/2014, Verordening [SOHO], Verordening (EU) 2017/745 en Verordening (EU) 2017/746 vallen</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="de">Daten aus klinischen Prüfungen, klinischen Studien und klinischen Untersuchungen, die der Verordnung (EU) 536/2014, der Verordnung [SOHO], der Verordnung (EU) 2017/745 und der Verordnung (EU) 2017/746 unterliegen</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Donnéeën aus klineschen Testen, klinesche Studien a klineschen Ënnersichungen, déi dem Reglement (EU) 536/2014, dem Reglement [SOHO], dem Reglement (EU) 2017/745 an dem Reglement (EU) 2017/746 respektiv ënnerleien</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data fra kliniske forsøg, kliniske undersøgelser og kliniske undersøgelser underlagt forordning (EU) 536/2014, forordning [SOHO], forordning (EU) 2017/745 og forordning (EU) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati provenienti da sperimentazioni cliniche, studi clinici e indagini cliniche soggette rispettivamente al Regolamento (UE) 536/2014, al Regolamento [SOHO], al Regolamento (UE) 2017/745 e al Regolamento (UE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα από κλινικές δοκιμές, κλινικές μελέτες και κλινικές έρευνες που υπόκεινται αντίστοιχα στον κανονισμό (ΕΕ) 536/2014, στον κανονισμό [SOHO], στον κανονισμό (ΕΕ) 2017/745 και στον κανονισμό (ΕΕ) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци од клинички испитувања, клинички студии и клинички истражувања предмет на Регулатива (ЕУ) 536/2014, Регулатива [SOHO], Регулатива (ЕУ) 2017/745 и Регулатива (ЕУ) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données provenant d'essais cliniques, d'études cliniques et d'investigations cliniques soumises respectivement au Règlement (UE) 536/2014, au Règlement [SOHO], au Règlement (UE) 2017/745 et au Règlement (UE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Data från kliniska prövningar, kliniska studier och kliniska undersökningar som omfattas av förordning (EU) 536/2014, förordning [SOHO], förordning (EU) 2017/745 och förordning (EU) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kliinisistä lääketutkimuksista, kliinisistä tutkimuksista ja kliinisistä tutkimuksista annetun asetuksen (EU) 536/2014, [SOHO]-asetuksen, asetuksen (EU) 2017/745 ja asetuksen (EU) 2017/746 mukaiset tiedot</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data from clinical trials, clinical studies, clinical investigations and performance studies subject to Regulation (EU) No 536/2014, Regulation (EU) 2024/1938 of the European Parliament and of the Council34, Regulation (EU) 2017/745 and Regulation (EU) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date din studii clinice, studii clinice și investigații clinice supuse Regulamentului (UE) 536/2014, Regulamentului [SOHO], Regulamentului (UE) 2017/745 și Regulamentului (UE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Údaje z klinických hodnocení, klinických studií a klinických zkoušek podle nařízení (EU) 536/2014, nařízení [SOHO], nařízení (EU) 2017/745 a nařízení (EU) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci iz kliničkih ispitivanja, kliničkih studija i kliničkih ispitivanja u skladu s Uredbom (EU) 536/2014, Uredbom [SOHO], Uredbom (EU) 2017/745 i Uredbom (EU) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane z badań klinicznych, badań klinicznych i badań klinicznych podlegających rozporządzeniu (UE) 536/2014, rozporządzeniu [SOHO], rozporządzeniu (UE) 2017/745 i rozporządzeniu (UE) 2017/746</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de ensaios clínicos, estudos clínicos e investigações clínicas sujeitos ao Regulamento (UE) 536/2014, Regulamento [SOHO], Regulamento (UE) 2017/745 e Regulamento (UE) 2017/746, respetivamente</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories">
    <dct:identifier>https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories</dct:identifier>
    <skos:altLabel xml:lang="en">Health Categories</skos:altLabel>
    <dct:title xml:lang="en">Health Categories</dct:title>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RMMD"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RPDG"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/WELA"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/NRPE"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EMRD"/>
    <skos:scopeNote xml:lang="en">The controlled vocabulary for the health category property within HealthDCAT-AP is a standardized set of terms that defines the specific categories of electronic health data as outlined in Article 51 of the EHDS Regulation. This vocabulary ensures consistent classification and tagging of datasets, facilitating accurate identification and interoperability across different health data systems. Each term within this controlled vocabulary corresponds to one of the 17 defined health data categories, allowing for clear, precise categorization of health datasets in compliance with regulatory requirements.</skos:scopeNote>
    <skos:prefLabel xml:lang="en">Health Categories</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EINS"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HPML"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/DIOH"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HGPD"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RQSH"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/IDHP"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/PHDR"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/MRMR"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/PGEH"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EHRS"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HRAD"/>
    <skos:hasTopConcept rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EHCT"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HRAD">
    <dct:identifier>HRAD</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="lv">Ar veselības aprūpi saistīti administratīvie dati, tostarp izsniegšanas, prasību un atlīdzības dati</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Administratieve gegevens met betrekking tot de gezondheidszorg, waaronder gegevens over verstrekking, claims en terugbetaling</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Gesondheetsbezunn Daten iwwer Verwaltung, abegraff Date iwwer Ausgab, Fuerderungen a Remuneratioun</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Administrativni podaci vezani uz zdravstvenu skrb, uključujući podatke o izdavanju, potraživanjima i naknadama</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Административни данни, свързани със здравеопазването, включително данни за отпускане, искове и възстановяване на разходи</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Administratívne údaje súvisiace so zdravotnou starostlivosťou, vrátane údajov o výdaji, nárokoch a úhradách</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane administracyjne związane z opieką zdrowotną, w tym dane dotyczące wydawania leków, roszczeń i refundacji</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos administrativos relacionados con la salud, incluidos los datos de dispensación, reclamaciones y reembolsos</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Διοικητικά δεδομένα που σχετίζονται με την υγειονομική περίθαλψη, συμπεριλαμβανομένων των δεδομένων διανομής, αξιώσεων και επιστροφών</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati amministrativi relativi alla sanità, inclusi i dati di dispensazione, rivendicazione e rimborso</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados administrativos relacionados com a saúde, incluindo dados de dispensa, reclamações e reembolsos</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Administrative data vedrørende sundhedspleje, herunder data om udlevering, krav og refusion</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="de">Verwaltungsdaten im Zusammenhang mit dem Gesundheitswesen, einschließlich Daten zur Abgabe, zu Ansprüchen und zur Erstattung</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Административни податоци поврзани со здравствена заштита, вклучително податоци за издавање, барања и наплата</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Tervishoiuga seotud haldusandmed, sealhulgas ravimite väljastamise, nõuete ja hüvitiste andmed</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Zdravstveni upravni podatki, vključno s podatki o izdaji, zahtevkih in povračilih</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Terveydenhuoltoon liittyvät hallinnolliset tiedot, mukaan lukien lääkkeenjakelu-, vaade- ja korvaustiedot</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données administratives liées aux soins de santé, y compris les données de dispensation, de réclamations et de remboursements</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Sveikatos priežiūros administraciniai duomenys, įskaitant išdavimo, pretenzijų ir kompensavimo duomenis</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí riaracháin a bhaineann le cúram sláinte, lena n-áirítear sonraí díola, éileamh agus aisíocaíochta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Administrativa uppgifter relaterade till hälso- och sjukvård, inklusive dispens-, skade- och ersättningsdata</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta amministrattiva relatata mal-kura tas-saħħa, inklużi dejta dwar l-għoti, it-talbiet u r-rimborż</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Healthcare-related administrative data, including on dispensations, reimbursement claims and reimbursements</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date administrative legate de asistența medicală, inclusiv date privind eliberarea, cererile și rambursările</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Az egészségüggyel kapcsolatos adminisztratív adatok, beleértve a kiadási, követelési és visszatérítési adatokat</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Administrativní údaje týkající se zdravotní péče, včetně údajů o vydávání léků, nárocích a úhradách</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna administrative që lidhen me kujdesin shëndetësor, duke përfshirë të dhënat e dhënies, pretendimeve dhe rimbursimeve</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/MRMR">
    <dct:identifier>MRMR</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="mt">Dejta mir-reġistri mediċi u reġistri tal-mortalità</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Údaje z lékařských registrů a registrů úmrtí</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tiedot lääketieteellisistä rekistereistä ja kuolleisuusrekistereistä</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données provenant des registres médicaux et des registres de mortalité</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date din registrele medicale și registrele de mortalitate</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati no medicīniskajiem reģistriem un mirstības reģistriem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens uit medische registers en sterfteregisters</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati dai registri medici e dai registri di mortalità</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed meditsiiniregistritest ja suremusregistritest</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje z lekárskych registrov a registrov úmrtnosti</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok orvosi nyilvántartásokból és halálozási nyilvántartásokból</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data from medical registries and mortality registries</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="lb">Donnéeën aus medizinesche Regësteren a Stierfregësteren</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys iš medicininių registrų ir mirtingumo registrų</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни от медицински регистри и регистри на смъртността</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane z rejestrów medycznych i rejestrów śmiertelności</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci iz medicinskih registara i registara smrtnosti</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de registros médicos y registros de mortalidad</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí ó chlárlanna míochaine agus clárlanna báis</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци од медицински регистри и регистри на смртност</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten aus medizinischen Registern und Sterberegistern</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Data från medicinska register och dödsregister</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data fra medicinske registre og dødsregistre</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα από ιατρικά μητρώα και μητρώα θνησιμότητας</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki iz medicinskih registrov in registrov umrljivosti</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna nga regjistrat mjekësorë dhe regjistrat e vdekshmërisë</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de registos médicos e registos de mortalidade</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RQSH">
    <dct:identifier>RQSH</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="ga">Sonraí ó chomhthorthaí taighde, ceistneoirí agus suirbhéanna a bhaineann leis an tsláinte, tar éis chéad fhoilsiú na dtorthaí</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Donnéeën aus Fuerschungskoorten, Froebéihe an Ëmfroen, déi mat der Gesondheet ze dinn hunn, no der éischter Publikatioun vun den Resultater</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta minn kohorti ta' riċerka, kwestjonarji u stħarriġ relatati mas-saħħa, wara l-ewwel pubblikazzjoni tar-riżultati</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna nga koorte kërkimore, pyetësorë dhe sondazhe të lidhura me shëndetin, pas publikimit të parë të rezultateve</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten aus Forschungskohorten, Fragebögen und Umfragen im Zusammenhang mit Gesundheit, nach der ersten Veröffentlichung der Ergebnisse</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Data från forskningskohorter, frågeformulär och undersökningar relaterade till hälsa, efter den första publiceringen av resultaten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens van onderzoekcohorten, vragenlijsten en enquêtes met betrekking tot gezondheid, na de eerste publicatie van de resultaten</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de coortes de pesquisa, questionários e inquéritos relacionados com a saúde, após a primeira publicação dos resultados</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα από ερευνητικές κοόρτες, ερωτηματολόγια και έρευνες που σχετίζονται με την υγεία, μετά την πρώτη δημοσίευση των αποτελεσμάτων</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data fra forskningskohorter, spørgeskemaer og undersøgelser relateret til sundhed, efter den første offentliggørelse af resultaterne</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date din cohorte de cercetare, chestionare și sondaje legate de sănătate, după prima publicare a rezultatelor</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok kutatási kohorszokból, kérdőívekből és egészséggel kapcsolatos felmérésekből, az eredmények első közzététele után</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="hr">Podaci iz istraživačkih kohorti, upitnika i anketa vezanih uz zdravlje, nakon prve objave rezultata</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed terviseuuringute kohortidest, küsimustikest ja uuringutest pärast tulemuste esmakordset avaldamist</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki iz raziskovalnih kohort, vprašalnikov in anket, povezanih z zdravjem, po prvi objavi rezultatov</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données provenant de cohortes de recherche, de questionnaires et d'enquêtes liés à la santé, après la première publication des résultats</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data from research cohorts, questionnaires and surveys related to health, after the first publication of the related results</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Data z výzkumných kohort, dotazníků a průzkumů týkajících se zdraví, po prvním zveřejnění výsledků</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys iš tyrimų kohortų, klausimynų ir apklausų, susijusių su sveikata, po pirmojo rezultatų paskelbimo</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни от изследователски кохорти, въпросници и анкети, свързани със здравето, след първата публикация на резултатите</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Terveyteen liittyvien tutkimuskohorttien, kyselylomakkeiden ja tutkimusten tiedot ensimmäisen tulosten julkaisun jälkeen</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane z kohort badawczych, kwestionariuszy i ankiet związanych ze zdrowiem, po pierwszej publikacji wyników</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati no pētījuma kohortām, anketām un aptaujām, kas saistītas ar veselību, pēc pirmās rezultātu publicēšanas</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje z výskumných kohort, dotazníkov a prieskumov týkajúcich sa zdravia po prvom zverejnení výsledkov</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de cohortes de investigación, cuestionarios y encuestas relacionados con la salud, tras la primera publicación de los resultados</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati da coorti di ricerca, questionari e sondaggi relativi alla salute, dopo la prima pubblicazione dei risultati</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци од истражувачки кохорти, прашалници и анкети поврзани со здравјето, по првата објава на резултатите</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HPML">
    <dct:identifier>HPML</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="et">Muud inimese molekulaarsed andmed, nagu proteoomilised, transkriptoomilised, metaboloomilised, lipidoomilised ja muud omikaandmed</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Други човечки молекуларни податоци, како што се протеомски, транскриптомски, метаболомски, липидомски и други омик податоци</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Andre humane molekylære data såsom proteomiske, transkriptomiske, metabolomiske, lipidomiske og andre omiske data</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Drugi človeški molekularni podatki, kot so proteomski, transkriptomski, metabolomski, lipidomski in drugi omični podatki</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Aner mënschlech molekulär Daten wéi proteomesch, transkriptomesch, metabolomesch, lipidomesch an aner omesch Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Autres données moléculaires humaines telles que les données protéomiques, transcriptomiques, métabolomiques, lipidomiques et autres données omiques</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Andere menschliche molekulare Daten wie proteomische, transkriptomische, metabolomische, lipidomische und andere omische Daten</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Andere menselijke moleculaire gegevens, zoals proteomische, transcriptoomische, metabolomische, lipidomische en andere omics-gegevens</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Други молекулярни данни за човека, като протеомни, транскриптомни, метаболомни, липидомни и други омни данни</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Citi cilvēka molekulārie dati, piemēram, proteomiskie, transkriptomiskie, metabolomiskie, lipidomiskie un citi omiskie dati</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Andra molekylära data från människor, såsom proteomiska, transkriptomiska, metabolomiska, lipidomiska och andra omics-data</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Other human molecular data such as proteomic, transcriptomic, metabolomic, lipidomic and other omic data</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="ro">Alte date moleculare umane, cum ar fi datele proteomice, transcriptomice, metabolomice, lipidomice și alte date omice</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Inne dane molekularne człowieka, takie jak dane proteomiczne, transkryptomiczne, metabolomiczne, lipidomiczne i inne dane omiczne</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna të tjera molekulare njerëzore si ato proteomike, transkriptomike, metabolomike, lipidomike dhe të dhëna të tjera omike</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Další molekulární data o člověku, jako jsou proteomická, transkriptomická, metabolomická, lipidomická a další omická data</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta molekulari oħra tal-bniedem bħal dejta proteomika, transkriptomika, metabolomika, lipidomika u dejta omika oħra</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Otros datos moleculares humanos como datos proteómicos, transcriptómicos, metabolómicos, lipidómicos y otros datos ómicos</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Outros dados moleculares humanos, como dados proteómicos, transcriptómicos, metabolómicos, lipidómicos e outros dados ómicos</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Egyéb humán molekuláris adatok, például proteomikai, transzkriptomikai, metabolomikai, lipidomikai és egyéb omikai adatok</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Ostali ljudski molekularni podaci poput proteomskih, transkriptomskih, metabolomskih, lipidomskih i drugih omičkih podataka</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Kiti žmogaus molekuliniai duomenys, tokie kaip proteominiai, transkriptominiai, metabolominiai, lipidominiai ir kiti omikiniai duomenys</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Iné molekulárne údaje o človeku, ako sú proteomické, transkriptomické, metabolomické, lipidomické a ďalšie omické údaje</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí móilíneacha daonna eile amhail sonraí próitéamaíocha, trascríptaíocha, meitibileamaíocha, lipidéamaíocha agus sonraí omacha eile</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Muut ihmisen molekyylitason tiedot, kuten proteomiikka-, transkriptiomiikka-, metabolomiikka-, lipidomiikka- ja muut omics-tiedot</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Altri dati molecolari umani come i dati proteomici, trascrittomici, metabolomici, lipidomici e altri dati omici</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Άλλα μοριακά δεδομένα του ανθρώπου, όπως πρωτεομικά, μεταγραφομικά, μεταβολομικά, λιπιδωματικά και άλλα ομικά δεδομένα</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RMMD">
    <dct:identifier>RMMD</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="ro">Date din registrele produselor medicinale și dispozitivelor medicale</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Data z registrů léčivých přípravků a zdravotnických prostředků</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data from registries for medicinal products and medical devices</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok gyógyszer- és orvostechnikai eszközök nyilvántartásaiból</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens uit registers voor geneesmiddelen en medische hulpmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna nga regjistrat për produktet mjekësore dhe pajisjet mjekësore</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tiedot lääke- ja lääkintälaiterekistereistä</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données provenant des registres des produits médicinaux et des dispositifs médicaux</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys iš vaistų ir medicinos prietaisų registrų</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци од регистри за лекови и медицински помагала</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki iz registrov za zdravila in medicinske pripomočke</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα από μητρώα φαρμακευτικών προϊόντων και ιατροτεχνολογικών συσκευών</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="sv">Data från register för läkemedel och medicintekniska produkter</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de registros de productos medicinales y dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten aus Registern für Arzneimittel und Medizinprodukte</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни от регистри на лекарствени продукти и медицински изделия</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed ravimite ja meditsiiniseadmete registritest</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de registos de produtos medicinais e dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Donnéeën aus Regësteren fir Medikamenter a medizinesch Apparater</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta mir-reġistri għall-prodotti mediċinali u apparat mediku</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane z rejestrów produktów leczniczych i wyrobów medycznych</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati no zāļu un medicīnas ierīču reģistriem</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data fra registre over lægemidler og medicinsk udstyr</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje z registrov liekov a zdravotníckych pomôcok</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí ó chlárlanna táirgí leighis agus gléasanna leighis</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci iz registara za lijekove i medicinske uređaje</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati provenienti dai registri di prodotti medicinali e dispositivi medici</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EINS">
    <dct:identifier>EINS</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="lt">Sveikatos duomenys iš biobankų ir susijusių duomenų bazių</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gezondheidsgegevens van biobanken en bijbehorende databanken</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Veselības dati no biobankām un saistītajām datu bāzēm</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhënat shëndetësore nga biobankat dhe bazat e të dhënave të lidhura</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date de sănătate din biobănci și baze de date asociate</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données de santé provenant de biobanques et de bases de données associées</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de saúde de biobancos e bases de dados associadas</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Sundhedsdata fra biobanker og tilknyttede databaser</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane zdrowotne z biobanków i powiązanych baz danych</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Biopankkien ja niihin liittyvien tietokantojen terveystiedot</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Health data from biobanks and associated databases</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Zdravstveni podatki iz biobank in povezanih baz podatkov</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="el">Δεδομένα υγείας από βιοτράπεζες και συναφείς βάσεις δεδομένων</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí sláinte ó bhiobhainc agus ó bhunachair sonraí ghaolmhara</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta tas-saħħa minn biobanks u databases assoċjati</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Zdravstveni podaci iz biobanka i povezanih baza podataka</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Zdravotní data z biobank a přidružených databází</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Hälsodata från biobanker och associerade databaser</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Gesundheitsdaten aus Biobanken und zugehörigen Datenbanken</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Zdravotné údaje z biobánk a pridružených databáz</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Здравствени податоци од биобанки и поврзани бази на податоци</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Gesondheetsdaten aus Biobanken an assoziéierten Datebanken</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Egészségügyi adatok biobankokból és kapcsolódó adatbázisokból</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati sanitari provenienti da biobanche e banche dati associate</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Terviseandmed biopankadest ja seotud andmebaasidest</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Здравни данни от биобанки и свързани бази данни</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de salud de biobancos y bases de datos asociadas</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/IDHP">
    <dct:identifier>IDHP</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="lb">Donnéeën iwwer de beruffleche Status, d'Spezialisatioun an d'Institutioun vun de Gesondheetsspezialisten, déi an d'Behandlung vun enger natierlecher Persoun involvéiert sinn</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни за професионалния статус, специализацията и институцията на здравните специалисти, участващи в лечението на физическо лице</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци за професионалниот статус, специјализација и институција на здравствените работници вклучени во лекувањето на физичко лице</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta dwar l-istatus professjonali, l-ispeċjalizzazzjoni u l-istituzzjoni tal-professjonisti tas-saħħa involuti fit-trattament ta' persuna fiżika</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati sullo stato professionale, la specializzazione e l'istituzione degli operatori sanitari coinvolti nel trattamento di una persona fisica</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí ar stádas gairmiúil, sainoiliúint agus institiúid ghairmithe sláinte atá bainteach le cóir leighis a chur ar dhuine nádúrtha</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date privind statutul profesional, specializarea și instituția profesioniștilor din domeniul sănătății implicați în tratamentul unei persoane fizice</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci o profesionalnom statusu, specijalizaciji i ustanovi zdravstvenih djelatnika uključenih u liječenje fizičke osobe</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Uppgifter om yrkesstatus, specialisering och institution för vårdpersonal som är involverad i behandlingen av en fysisk person</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Údaje o profesním postavení, specializaci a instituci zdravotnických pracovníků zapojených do léčby fyzické osoby</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens over de professionele status, specialisatie en instelling van gezondheidswerkers die betrokken zijn bij de behandeling van een natuurlijke persoon</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data om sundhedspersoners erhvervsmæssige status, specialisering og institution, der er involveret i behandlingen af en fysisk person</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="es">Datos sobre el estado profesional, la especialización y la institución de los profesionales de la salud involucrados en el tratamiento de una persona física</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten zum beruflichen Status, zur Spezialisierung und zur Einrichtung von Gesundheitsfachkräften, die an der Behandlung einer natürlichen Person beteiligt sind</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane dotyczące statusu zawodowego, specjalizacji i instytucji pracowników służby zdrowia zaangażowanych w leczenie osoby fizycznej</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati par veselības aprūpes speciālistu profesionālo statusu, specializāciju un iestādi, kas iesaistīta fiziskas personas ārstēšanā</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα σχετικά με την επαγγελματική κατάσταση, την ειδικότητα και το ίδρυμα των επαγγελματιών υγείας που εμπλέκονται στη θεραπεία ενός φυσικού προσώπου</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki o poklicnem statusu, specializaciji in instituciji zdravstvenih delavcev, ki sodelujejo pri zdravljenju fizične osebe</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tiedot luonnollisen henkilön hoidossa mukana olevien terveydenhuollon ammattilaisten ammatillisesta asemasta, erikoistumisesta ja laitoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys apie fizinio asmens gydyme dalyvaujančių sveikatos priežiūros specialistų profesinę padėtį, specializaciją ir instituciją</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed füüsilise isiku ravis osalevate tervishoiutöötajate ametialase staatuse, spetsialiseerumise ja asutuse kohta</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok a természetes személy kezelésében részt vevő egészségügyi szakemberek szakmai státuszáról, szakterületéről és intézményéről</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data on professional status, and on the specialisation and institution of health professionals involved in the treatment of a natural person</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données sur le statut professionnel, la spécialisation et l'établissement des professionnels de santé impliqués dans le traitement d'une personne physique</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje o profesijnom postavení, špecializácii a inštitúcii zdravotníckych pracovníkov zapojených do liečby fyzickej osoby</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados sobre o estado profissional, a especialização e a instituição dos profissionais de saúde envolvidos no tratamento de uma pessoa singular</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna mbi statusin profesional, specializimin dhe institucionin e profesionistëve të shëndetit të përfshirë në trajtimin e një personi fizik</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EHRS">
    <dct:identifier>EHRS</dct:identifier>
     <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
     <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
     <skos:prefLabel xml:lang="bg">Електронни здравни досиета</skos:prefLabel>
     <skos:prefLabel xml:lang="fi">Sähköiset terveystiedot</skos:prefLabel>
     <skos:prefLabel xml:lang="pt">Registos de Saúde Eletrónicos</skos:prefLabel>
     <skos:prefLabel xml:lang="sv">Elektroniska patientjournaler</skos:prefLabel>
     <skos:prefLabel xml:lang="ga">Taifid Leictreonacha Sláinte</skos:prefLabel>
     <skos:prefLabel xml:lang="et">Elektroonilised terviseandmed</skos:prefLabel>
     <skos:prefLabel xml:lang="sq">Regjistrat Elektronikë të Shëndetit</skos:prefLabel>
     <skos:prefLabel xml:lang="hu">Elektronikus egészségügyi nyilvántartások</skos:prefLabel>
     <skos:prefLabel xml:lang="sk">Elektronické zdravotné záznamy</skos:prefLabel>
     <skos:prefLabel xml:lang="es">Registros Electrónicos de Salud</skos:prefLabel>
     <skos:prefLabel xml:lang="da">Elektroniske sundhedsregistre</skos:prefLabel>
     <skos:prefLabel xml:lang="hr">Elektronički zdravstveni kartoni</skos:prefLabel>
     <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
     <skos:prefLabel xml:lang="mt">Rekords Elettroniċi tas-Saħħa</skos:prefLabel>
     <skos:prefLabel xml:lang="fr">Dossiers de santé électroniques</skos:prefLabel>
     <skos:prefLabel xml:lang="sl">Elektronski zdravstveni kartoni</skos:prefLabel>
     <skos:prefLabel xml:lang="lb">Elektronesch Gesondheetsdossieren</skos:prefLabel>
     <skos:prefLabel xml:lang="ro">Dosare Electronice de Sănătate</skos:prefLabel>
     <skos:prefLabel xml:lang="cs">Elektronické zdravotní záznamy</skos:prefLabel>
     <skos:prefLabel xml:lang="pl">Elektroniczna dokumentacja medyczna</skos:prefLabel>
     <skos:prefLabel xml:lang="mk">Електронски здравствени записи</skos:prefLabel>
     <skos:prefLabel xml:lang="lt">Elektroniniai sveikatos įrašai</skos:prefLabel>
     <skos:prefLabel xml:lang="lv">Elektroniskie veselības ieraksti</skos:prefLabel>
     <skos:prefLabel xml:lang="de">Elektronische Gesundheitsakten</skos:prefLabel>
     <skos:prefLabel xml:lang="nl">Elektronische Gezondheidsdossiers</skos:prefLabel>
     <skos:prefLabel xml:lang="it">Cartelle cliniche elettroniche</skos:prefLabel>
     <skos:prefLabel xml:lang="en">Electronic Health Data from EHRs</skos:prefLabel>
     <skos:prefLabel xml:lang="el">Ηλεκτρονικοί Φάκελοι Υγείας</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/NRPE">
    <dct:identifier>NRPE</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Aggregated data on healthcare needs, resources allocated to healthcare, the provision of and access to healthcare, healthcare expenditure and financing</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données agrégées sur les besoins en soins de santé, les ressources allouées aux soins de santé, la prestation et l'accès aux soins de santé, les dépenses de santé et le financement de la santé</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Kogutud andmed tervishoiuvajaduste, tervishoiule eraldatud ressursside, tervishoiuteenuste osutamise ja kättesaadavuse, tervishoiukulutuste ja rahastamise kohta</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Agregirani podatki o potrebah po zdravstvenem varstvu, sredstvih dodeljenih za zdravstveno varstvo, zagotavljanju zdravstvenega varstva in dostopu do njega, izdatkih za zdravstveno varstvo in financiranju</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Aggregerade data om hälso- och sjukvårdsbehov, resurser som tilldelats hälso- och sjukvård, tillhandahållande av och tillgång till hälso- och sjukvård, hälso- och sjukvårdsutgifter och finansiering</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Агрегирани данни за здравните нужди, ресурсите, отпуснати за здравеопазване, предоставянето на здравни услуги и достъпа до здравеопазване, здравните разходи и финансирането</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Agregované údaje o potrebách zdravotnej starostlivosti, zdrojoch pridelených na zdravotnú starostlivosť, poskytovaní zdravotnej starostlivosti a prístupe k nej, výdavkoch na zdravotnú starostlivosť a jej financovaní</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Aggregerede data om sundhedsbehov, ressourcer tildelt sundhedspleje, levering af og adgang til sundhedspleje, sundhedsudgifter og finansiering</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati aggregati sui bisogni sanitari, le risorse destinate alla sanità, la fornitura e l'accesso all'assistenza sanitaria, le spese sanitarie e il finanziamento della sanità</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Συγκεντρωτικά δεδομένα σχετικά με τις ανάγκες υγειονομικής περίθαλψης, τους πόρους που διατίθενται στην υγειονομική περίθαλψη, την παροχή και πρόσβαση στην υγειονομική περίθαλψη, τις δαπάνες και τη χρηματοδότηση της υγειονομικής περίθαλψης</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna të agreguara mbi nevojat për kujdes shëndetësor, burimet e alokuara për kujdes shëndetësor, ofrimin dhe aksesin në kujdes shëndetësor, shpenzimet dhe financimin e kujdesit shëndetësor</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Aggregéiert Donnéeën iwwer d'Gesondheetsversuergungsbedürfnisser, Ressourcen, déi fir d'Gesondheetsversuergung zougewisen ginn, d'Bereetstellung an den Zougang zur Gesondheetsversuergung, d'Gesondheetskäschten an d'Finanzéierung</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="de">Aggregierte Daten zu Gesundheitsbedürfnissen, den für die Gesundheitsversorgung zugewiesenen Ressourcen, der Bereitstellung und dem Zugang zur Gesundheitsversorgung, den Gesundheitsausgaben und der Gesundheitsfinanzierung</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Agregirani podaci o zdravstvenim potrebama, resursima dodijeljenim za zdravstvenu skrb, pružanju i dostupnosti zdravstvene skrbi, zdravstvenoj potrošnji i financiranju</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta aggregata dwar il-bżonnijiet tal-kura tas-saħħa, ir-riżorsi allokati lill-kura tas-saħħa, il-provvediment u l-aċċess għall-kura tas-saħħa, l-infiq fuq il-kura tas-saħħa u l-finanzjament</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos agregados sobre las necesidades de atención sanitaria, los recursos asignados a la atención sanitaria, la prestación y el acceso a la atención sanitaria, el gasto sanitario y la financiación</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Zagregowane dane dotyczące potrzeb zdrowotnych, zasobów przeznaczonych na opiekę zdrowotną, świadczenia i dostępu do opieki zdrowotnej, wydatków na opiekę zdrowotną oraz finansowania</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Агрегирани податоци за потребите од здравствена заштита, ресурсите доделени за здравствена заштита, обезбедувањето и пристапот до здравствена заштита, трошоците за здравствена заштита и финансирањето</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí comhiomlána ar riachtanais cúraim sláinte, acmhainní a leithdháiltear ar chúram sláinte, an soláthar agus an rochtain ar chúram sláinte, caiteachas agus maoiniú sláinte</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Agregovaná data o potřebách zdravotní péče, zdrojích přidělených na zdravotní péči, poskytování a přístupu ke zdravotní péči, výdajích na zdravotní péči a financování</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados agregados sobre as necessidades de saúde, os recursos atribuídos aos cuidados de saúde, a prestação e o acesso aos cuidados de saúde, as despesas de saúde e o financiamento</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Yhdistetyt tiedot terveydenhuollon tarpeista, terveydenhuoltoon osoitetuista resursseista, terveydenhuollon tarjoamisesta ja saatavuudesta, terveydenhuoltomenoista ja rahoituksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geaggregeerde gegevens over gezondheidszorgbehoeften, middelen die aan gezondheidszorg zijn toegewezen, de verstrekking van en toegang tot gezondheidszorg, gezondheidszorguitgaven en -financiering</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date agregate privind nevoile de asistență medicală, resursele alocate asistenței medicale, furnizarea și accesul la asistență medicală, cheltuielile și finanțarea în domeniul sănătății</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Apkopotie dati par veselības aprūpes vajadzībām, veselības aprūpei piešķirtajiem resursiem, veselības aprūpes sniegšanu un pieejamību, veselības aprūpes izdevumiem un finansējumu</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Aggregált adatok az egészségügyi szükségletekről, az egészségügyre fordított erőforrásokról, az egészségügyi ellátás nyújtásáról és hozzáférhetőségéről, az egészségügyi kiadásokról és a finanszírozásról</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Sukaupti duomenys apie sveikatos priežiūros poreikius, sveikatos priežiūrai skirtus išteklius, sveikatos priežiūros teikimą ir prieinamumą, sveikatos priežiūros išlaidas ir finansavimą</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/DIOH">
    <dct:identifier>DIOH</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="fi">Tiedot terveyteen vaikuttavista tekijöistä, mukaan lukien sosioekonomiset, ympäristölliset ja käyttäytymiseen liittyvät terveyden määräävät tekijät</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Donnéeën iwwer Facteuren, déi d'Gesondheet beaflossen, abegraff sozio-ekonomesch, ëmweltbezunn an Verhalensdeterminante vun der Gesondheet</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatok az egészséget befolyásoló tényezőkről, beleértve a szocioökonómiai, környezeti és viselkedési egészségmeghatározókat</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date privind factorii care afectează sănătatea, inclusiv determinanții socio-economici, de mediu și comportamentali ai sănătății</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna mbi faktorët që ndikojnë në shëndet, duke përfshirë përcaktuesit socio-ekonomikë, mjedisorë dhe të sjelljes së shëndetit</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki o dejavnikih, ki vplivajo na zdravje, vključno s socialno-ekonomskimi, okoljskimi in vedenjskimi dejavniki zdravja</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane dotyczące czynników wpływających na zdrowie, w tym społeczno-ekonomicznych, środowiskowych i behawioralnych uwarunkowań zdrowia</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados sobre fatores que afetam a saúde, incluindo determinantes socioeconómicos, ambientais e comportamentais da saúde</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Daten zu gesundheitsbeeinflussenden Faktoren, einschließlich sozioökonomischer, umweltbedingter und verhaltensbezogener Determinanten der Gesundheit</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta dwar fatturi li jaffettwaw is-saħħa, inklużi determinanti tas-saħħa soċjoekonomiċi, ambjentali u ta' mġiba</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Data o faktorech ovlivňujících zdraví, včetně socioekonomických, environmentálních a behaviorálních determinantů zdraví</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data on factors impacting on health, including socio-economic, environmental and behavioural determinants of health</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="it">Dati sui fattori che incidono sulla salute, compresi i determinanti socio-economici, ambientali e comportamentali della salute</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevens over factoren die van invloed zijn op de gezondheid, waaronder sociaaleconomische, milieu- en gedragsdeterminanten van gezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни за факторите, влияещи върху здравето, включително социално-икономически, екологични и поведенчески фактори за здравето</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci o čimbenicima koji utječu na zdravlje, uključujući socioekonomske, ekološke i bihevioralne odrednice zdravlja</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Dati par faktoriem, kas ietekmē veselību, tostarp par sociālekonomiskajiem, vides un uzvedības veselības noteicošajiem faktoriem</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenys apie sveikatą lemiančius veiksnius, įskaitant sveikatos socialinius ir ekonominius, aplinkos ir elgsenos veiksnius</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmed tervist mõjutavate tegurite kohta, sealhulgas tervise sotsiaalmajanduslikud, keskkonna- ja käitumismääravad</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Data om faktorer, der påvirker sundheden, herunder socioøkonomiske, miljømæssige og adfærdsmæssige determinanter for sundhed</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí ar na fachtóirí a bhfuil tionchar acu ar shláinte, lena n-áirítear na cinnteoirí sóisialta, comhshaoil agus iompraíochta ar shláinte</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα για παράγοντες που επηρεάζουν την υγεία, συμπεριλαμβανομένων των κοινωνικοοικονομικών, περιβαλλοντικών και συμπεριφορικών παραγόντων της υγείας</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Data om faktorer som påverkar hälsan, inklusive socioekonomiska, miljömässiga och beteendemässiga bestämningsfaktorer för hälsa</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos sobre factores que afectan a la salud, incluidos los determinantes socioeconómicos, ambientales y de comportamiento de la salud</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Податоци за факторите што влијаат на здравјето, вклучително и социо-економските, еколошките и бихевиоралните фактори на здравјето</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données sur les facteurs influant sur la santé, y compris les déterminants socio-économiques, environnementaux et comportementaux de la santé</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje o faktoroch vplývajúcich na zdravie, vrátane sociálno-ekonomických, environmentálnych a behaviorálnych determinantov zdravia</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/PGEH">
    <dct:identifier>PGEH</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="de">Automatisch generierte persönliche elektronische Gesundheitsdaten durch medizinische Geräte</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Automaticky generovaná osobní elektronická zdravotní data prostřednictvím zdravotnických prostředků</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos electrónicos de salud personales generados automáticamente a través de dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta personali elettroniċi tas-saħħa ġenerati awtomatikament permezz ta' apparat mediku</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Automatiskt genererade personliga elektroniska hälsodata via medicintekniska produkter</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données de santé électroniques personnelles générées automatiquement via des dispositifs médicaux</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Automatiškai sugeneruoti asmeniniai elektroniniai sveikatos duomenys per medicinos prietaisus</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados eletrónicos de saúde pessoais gerados automaticamente através de dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Автоматски генерирани лични електронски здравствени податоци преку медицински помагала</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Automatesch generéiert perséinlech elektronesch Gesondheetsdaten duerch medizinesch Apparater</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date de sănătate electronice personale generate automat prin dispozitive medicale</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Αυτόματα δημιουργημένα προσωπικά ηλεκτρονικά δεδομένα υγείας μέσω ιατροτεχνολογικών προϊόντων</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="en">Personal electronic health data automatically generated through medical devices</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Automatski generirani osobni elektronički zdravstveni podaci putem medicinskih uređaja</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Automatisk genererede personlige elektroniske sundhedsdata gennem medicinsk udstyr</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Automaattisesti tuotetut henkilökohtaiset sähköiset terveystiedot lääketieteellisten laitteiden kautta</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Automatisch gegenereerde persoonlijke elektronische gezondheidsgegevens via medische hulpmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Автоматично генерирани лични електронни здравни данни чрез медицински изделия</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí leictreonacha sláinte pearsanta a ghintear go huathoibríoch trí ghléasanna leighis</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati sanitari elettronici personali generati automaticamente tramite dispositivi medici</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Automaticky generované osobné elektronické zdravotné údaje prostredníctvom zdravotníckych pomôcok</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Automaatselt loodud isiklikud elektroonilised terviseandmed meditsiiniseadmete kaudu</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Orvostechnikai eszközök által automatikusan generált személyes elektronikus egészségügyi adatok</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Automatycznie generowane osobiste elektroniczne dane medyczne za pośrednictwem urządzeń medycznych</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Samodejno generirani osebni elektronski zdravstveni podatki prek medicinskih pripomočkov</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Automātiski ģenerēti personiskie elektroniskie veselības dati, izmantojot medicīnas ierīces</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna shëndetësore elektronike personale të krijuara automatikisht përmes pajisjeve mjekësore</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
</rdf:RDF>
