  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EMRD">
    <dct:identifier>EMRD</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="en">Other health data from medical devices</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Otros datos de salud de dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Autres données de santé provenant de dispositifs médicaux</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna të tjera shëndetësore nga pajisjet mjekësore</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta oħra dwar is-saħħa minn apparat mediku</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Drugi zdravstveni podatki iz medicinskih pripomočkov</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Inne dane zdrowotne z wyrobów medycznych</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Outros dados de saúde de dispositivos médicos</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Citi veselības dati no medicīnas ierīcēm</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Andere Gesundheitsdaten von Medizinprodukten</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí eile sláinte ó ghléasanna leighis</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Iné zdravotné údaje zo zdravotníckych pomôcok</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="el">Άλλα δεδομένα υγείας από ιατροτεχνολογικά προϊόντα</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Ostali zdravstveni podaci iz medicinskih uređaja</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Egyéb egészségügyi adatok orvostechnikai eszközökből</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Andere gezondheidsgegevens van medische hulpmiddelen</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Altri dati sanitari da dispositivi medici</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Aner Gesondheetsdaten aus medizineschen Apparater</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Jiné zdravotní údaje ze zdravotnických prostředků</skos:prefLabel>
    <skos:prefLabel xml:lang="mk">Други здравствени податоци од медицински помагала</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Muut terveystiedot lääkinnällisistä laitteista</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Muud terviseandmed meditsiiniseadmetest</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Kiti sveikatos duomenys iš medicinos prietaisų</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Alte date de sănătate din dispozitive medicale</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Други здравни данни от медицински изделия</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Andre sundhedsdata fra medicinsk udstyr</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Andra hälsodata från medicintekniska produkter</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/RPDG">
    <dct:identifier>RPDG</dct:identifier>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel xml:lang="sv">Patogendata som påverkar människors hälsa</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Dati sui patogeni, con impatto sulla salute umana</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sonraí pataigin a bhfuil tionchar acu ar shláinte an duine</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Patogēnu dati, kas ietekmē cilvēku veselību</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Podaci o patogenima koji utječu na ljudsko zdravlje</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Podatki o patogenih, ki vplivajo na zdravje ljudi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data on pathogens that impact human health</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Pathogendaten mit Auswirkungen auf die menschliche Gesundheit</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Date despre agenții patogeni care afectează sănătatea umană</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Údaje o patogénoch, ktoré ovplyvňujú ľudské zdravie</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Patogeenitiedot, jotka vaikuttavat ihmisten terveyteen</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Dejta tal-patoġeni li għandhom impatt fuq is-saħħa tal-bniedem</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
    <skos:prefLabel xml:lang="mk">Податоци за патогени што влијаат на здравјето на луѓето</skos:prefLabel>
    <skos:prefLabel xml:lang="sq">Të dhëna të patogjenëve që ndikojnë në shëndetin e njeriut</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Patogenų duomenys, turintys įtakos žmonių sveikatai</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Patogendata, der påvirker menneskers sundhed</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Δεδομένα παθογόνων μικροοργανισμών που επηρεάζουν την ανθρώπινη υγεία</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Datos de patógenos que afectan a la salud humana</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Údaje o patogenech ovlivňujících lidské zdraví</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Данни за патогени, засягащи човешкото здраве</skos:prefLabel>
    <skos:prefLabel xml:lang="lb">Pathogendonnéeën, déi d'Gesondheet vum Mënsch beaflossen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Pathogeengegevens die van invloed zijn op de menselijke gezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Dados de agentes patogénicos que afetam a saúde humana</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dane o patogenach wpływających na zdrowie ludzi</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Données sur les agents pathogènes, ayant un impact sur la santé humaine</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Patogeeniandmed, mis mõjutavad inimeste tervist</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A kórokozókra vonatkozó adatok, amelyek hatással vannak az emberi egészségre</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/WELA">
