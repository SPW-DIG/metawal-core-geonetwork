    <dct:identifier xml:lang="en">LIFECOURSE_HEALTH</dct:identifier>
    <skos:definition xml:lang="en">Health across life stages, including maternal, newborn, child, adolescent, and older-age health and inequities such as ageism.</skos:definition>
