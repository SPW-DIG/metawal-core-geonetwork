    <skos:prefLabel xml:lang="fr">Urgences, catastrophes, voyages et contextes humanitaires</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Vészhelyzetek, katasztrófák, utazás és humanitárius helyzetek</skos:prefLabel>
