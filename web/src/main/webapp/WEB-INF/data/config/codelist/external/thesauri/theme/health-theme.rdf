    <skos:prefLabel xml:lang="nb">Nødsituasjoner, katastrofer, reiser og humanitære forhold</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Hätätilanteet, katastrofit, matkailu ja humanitaariset olosuhteet</skos:prefLabel>
