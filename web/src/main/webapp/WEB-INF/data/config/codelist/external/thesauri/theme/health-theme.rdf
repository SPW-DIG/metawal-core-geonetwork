  <skos:Concept rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme/ANTIMICROBIAL_CONTROL">
    <dct:identifier xml:lang="en">ANTIMICROBIAL_CONTROL</dct:identifier>
    <skos:definition xml:lang="en">Resistance threats and the practices that prevent or reduce transmission and healthcare-associated infections.</skos:definition>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme" />
    <dct:title xml:lang="en">Antimicrobial resistance &amp; infection control</dct:title>
    <skos:prefLabel xml:lang="ro">Rezistența la antimicrobiene și controlul infecțiilor</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Odpornost proti mikrobom in obvladovanje okužb</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Resistenza antimicrobica e controllo delle infezioni</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Otpornost na antimikrobne lijekove i kontrola infekcija</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Résistance aux antimicrobiens et contrôle des infections</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Resistencia a los antimicrobianos y control de las infecciones</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Oporność na środki przeciwdrobnoustrojowe i kontrola zakażeń</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Antimikrobiální rezistence a kontrola infekcí</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Antimikrobiális rezisztencia és fertőzések elleni védekezés</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Αντιμικροβιακή αντοχή και έλεγχos των λοιμώξεων</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Antimikrobiālā rezistence un infekciju kontrole</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Antimicrobiële resistentie &amp; infectiebeheersing</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Antimikrobiálna rezistencia a kontrola infekcií</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme" />
    <dct:description xml:lang="en">Resistance threats and the practices that prevent or reduce transmission and healthcare-associated infections.</dct:description>
    <skos:prefLabel xml:lang="mt">Reżistenza għall-antimikrobiċi u kontroll tal-infezzjonijiet</skos:prefLabel>
    <skos:prefLabel xml:lang="nb">Antimikrobiell resistens og smittevern</skos:prefLabel>
    <skos:prefLabel xml:lang="is">Sýklalyfjaónæmi og sýkingavarnir</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Antimicrobial resistance &amp; infection control</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Resistência antimicrobiana e controlo de infeções</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Антимикробна резистентност и контрол на инфекциите</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Antimikrobiell resistens och infektionskontroll</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Atsparumas antimikrobinėms medžiagoms ir infekcijų kontrolė</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Mikroobivastane resistentsus ja nakkustõrje</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Antimikrobiel resistens og infektionskontrol</skos:prefLabel>
    <skos:prefLabel xml:lang="nn">Antimikrobiell resistens og smittevern</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Mikrobilääkeresistenssi ja infektioiden torjunta</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Frithsheasmhacht in aghaidh ábhair fhrithmhiocróbacha &amp; rialú ionfhabhtuithe</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Antimikrobielle Resistenz und Infektionskontrolle</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme/BLOOD_INFECTIONS">
    <dct:identifier xml:lang="en">BLOOD_INFECTIONS</dct:identifier>
    <skos:definition xml:lang="en">Infections transmitted by blood exposure or sexual contact (e.g., HIV, hepatitis, STIs).</skos:definition>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme" />
    <dct:title xml:lang="en">Blood-borne &amp; sexually transmitted infections</dct:title>
    <skos:prefLabel xml:lang="ro">Infecții cu transmitere sanguină și cu transmitere sexuală</skos:prefLabel>
    <skos:prefLabel xml:lang="nn">Blodborne og seksuelt overførbare infeksjonar</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Krvou prenosné a pohlavne prenosné choroby</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Blood-borne &amp; sexually transmitted infections</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Ar asinīm un seksuāli transmisīvām infekcijām</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Blutübertragbare und sexuell übertragbare Infektionen</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Door bloed overgedragen en seksueel overdraagbare aandoeningen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Veriteitse ja sukupuoliteitse tarttuvat infektiot</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Blodburna och sexuellt överförbara infektioner</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Infezioni a trasmissione ematica e sessuale</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Blodbårne og seksuelt overførte infektioner</skos:prefLabel>
    <skos:prefLabel xml:lang="is">Blóðbornar og kynsýkingar</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Okužbe, ki se prenašajo s krvjo in spolnim stikom</skos:prefLabel>
    <skos:inScheme rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme" />
    <dct:description xml:lang="en">Infections transmitted by blood exposure or sexual contact (e.g., HIV, hepatitis, STIs).</dct:description>
    <skos:prefLabel xml:lang="hu">Vérrel és szexuális úton terjedő fertőzések</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Krevní a pohlavně přenosné infekce</skos:prefLabel>
    <skos:prefLabel xml:lang="nb">Blod- og seksuelt overførbare infeksjoner</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Infeções de transmissão sanguínea e sexualmente transmissíveis</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Инфекции, предавани по кръвен и полов път</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Αιματογενείς και σεξουαλικά μεταδιδόμενες λοιμώξεις</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Infecciones de transmisión sanguínea y de transmisión sexual</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Ionfhabhtuithe fola-iompartha &amp; gnéas-tarchurtha</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Krauju plintančios ir lytiškai plintančios infekcijos</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Zakażenia przenoszone drogą płciową i przez krew</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Spolno prenosive i krvlju prenosive bolesti</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Infezzjonijiet li jinġarru mid-demm u li jiġu trażmessi sesswalment</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Verega ja sugulisel teel levivad nakkused</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Infections transmissibles par le sang et sexuellement transmissibles</skos:prefLabel>
  </skos:Concept>
