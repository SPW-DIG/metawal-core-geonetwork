  <skos:Concept rdf:about="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme/ENTERIC_INFECTIONS">
    <dct:identifier xml:lang="en">ENTERIC_INFECTIONS</dct:identifier>
    <skos:definition xml:lang="en">Pathogens spread via contaminated water or food and fecal–oral routes, including diarrhoeal disease and many intestinal helminth infections.</skos:definition>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/health-theme" />
    <dct:title xml:lang="en">Enteric, water- &amp; food-borne infections</dct:title>
    <skos:prefLabel xml:lang="pl">Zakażenia jelitowe, wodnopochodne i pokarmowe</skos:prefLabel>
    <skos:prefLabel xml:lang="nn">Tarm-, vass- og matborne infeksjonar</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Infections entériques, hydriques et alimentaires</skos:prefLabel>
