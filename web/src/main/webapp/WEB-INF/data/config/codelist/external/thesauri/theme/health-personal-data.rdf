    <dc:identifier>Communication</dc:identifier>
    <skos:prefLabel xml:lang="en">Communication</skos:prefLabel>
    <skos:definition xml:lang="en">Information communicated from or to an individual</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Social" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#CommunicationsMetadata">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
