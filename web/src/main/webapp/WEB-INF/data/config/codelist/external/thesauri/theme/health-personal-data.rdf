    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Age" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BirthPlace">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BirthPlace</dc:identifier>
