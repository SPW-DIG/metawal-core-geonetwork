    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Location" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BloodType">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BloodType</dc:identifier>
    <skos:prefLabel xml:lang="en">Blood Type</skos:prefLabel>
