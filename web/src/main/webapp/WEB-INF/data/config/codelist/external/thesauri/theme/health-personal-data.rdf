    <skos:definition xml:lang="en">Information about and including connections in a social network</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#SocialNetwork" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Contact">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Contact</dc:identifier>
    <skos:prefLabel xml:lang="en">Contact</skos:prefLabel>
    <skos:definition xml:lang="en">Information about contacts or used for contacting e.g. email address or phone number</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Tracking" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Country">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Country</dc:identifier>
    <skos:prefLabel xml:lang="en">Country</skos:prefLabel>
    <skos:definition xml:lang="en">Information about country e.g. residence, travel</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Location" />
