  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BrowserFingerprint">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BrowserFingerprint</dc:identifier>
    <skos:prefLabel xml:lang="en">Browser Fingerprint</skos:prefLabel>
