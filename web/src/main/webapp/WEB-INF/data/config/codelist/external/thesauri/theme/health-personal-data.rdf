  <skos:ConceptScheme rdf:about="https://w3id.org/dpv/pd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-06-04</dct:created>
    <rdfs:label xml:lang="en">DPV Personal Data Categories</rdfs:label>
    <skos:prefLabel xml:lang="en">DPV Personal Data Categories</skos:prefLabel>
    <dct:title xml:lang="en">DPV Personal Data Categories</dct:title>
    <dct:description xml:lang="en">Personal Data categories from the W3C Data Privacy Vocabulary (DPV) version 2.3</dct:description>
    <dct:identifier>https://w3id.org/dpv/pd</dct:identifier>
    <owl:versionIRI rdf:resource="https://w3id.org/dpv/pd/2.3" />
    <owl:versionInfo>2.3</owl:versionInfo>
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Biometric" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#EthnicOrigin" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#External" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Financial" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Historical" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Household" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Internal" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#MedicalHealth" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#PhilosophicalBelief" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#PoliticalAffiliation" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#PoliticalOpinion" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Profile" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Race" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Religion" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#ReligiousBelief" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Sexual" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Social" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Tracking" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#TradeUnionMembership" />
    <skos:hasTopConcept rdf:resource="https://w3id.org/dpv/pd#Vulnerability" />
  </skos:ConceptScheme>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Accent">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Accent</dc:identifier>
    <skos:prefLabel xml:lang="en">Accent</skos:prefLabel>
    <skos:definition xml:lang="en">Information about linguistic and speech accents</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Language" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#AccountIdentifier">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>AccountIdentifier</dc:identifier>
    <skos:prefLabel xml:lang="en">Account Identifier</skos:prefLabel>
    <skos:definition xml:lang="en">Information about financial account identifier</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#FinancialAccount" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Acquaintance">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Acquaintance</dc:identifier>
    <skos:prefLabel xml:lang="en">Acquaintance</skos:prefLabel>
    <skos:definition xml:lang="en">Information about acquaintances in a social network</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#SocialNetwork" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Age">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Age</dc:identifier>
    <skos:prefLabel xml:lang="en">Age</skos:prefLabel>
    <skos:definition xml:lang="en">Information about age</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#PhysicalCharacteristic" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#AgeExact">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>AgeExact</dc:identifier>
    <skos:prefLabel xml:lang="en">Age Exact</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the exact age (i.e. to some degree within a year, month, or day)</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#AgeRange" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#AgeRange">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>AgeRange</dc:identifier>
    <skos:prefLabel xml:lang="en">Age Range</skos:prefLabel>
    <skos:definition xml:lang="en">Information about age range i.e. inexact age to some degree (i.e. some years)</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Age" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#ApartmentOwned">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>ApartmentOwned</dc:identifier>
    <skos:prefLabel xml:lang="en">Apartment Owned</skos:prefLabel>
    <skos:definition xml:lang="en">Information about apartment(s) owned and its history</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#HouseOwned" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Association">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Association</dc:identifier>
    <skos:prefLabel xml:lang="en">Association</skos:prefLabel>
    <skos:definition xml:lang="en">Information about associations in a social network with other individuals, groups, or entities e.g. friend of a friend</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#SocialNetwork" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Attitude">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Attitude</dc:identifier>
    <skos:prefLabel xml:lang="en">Attitude</skos:prefLabel>
    <skos:definition xml:lang="en">Information about attitude</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Behavioural" />
