    <skos:definition xml:lang="en">Information about and including web browsing history</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#BrowsingBehaviour" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BrowsingBehaviour">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BrowsingBehaviour</dc:identifier>
    <skos:prefLabel xml:lang="en">Browsing Behaviour</skos:prefLabel>
    <skos:definition xml:lang="en">Information about browsing behaviour</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Behavioural" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BrowsingReferral">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BrowsingReferral</dc:identifier>
    <skos:prefLabel xml:lang="en">Browsing Referral</skos:prefLabel>
    <skos:definition xml:lang="en">Information about web browsing referrer or referral, which can be based on location, targeted referrals, direct, organic search, social media or actions, campaigns.</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#BrowsingBehaviour" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#CallLog">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>CallLog</dc:identifier>
    <skos:prefLabel xml:lang="en">Call Log</skos:prefLabel>
    <skos:definition xml:lang="en">Information about the calls that an individual has made</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Behavioural" />
