  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Authenticating">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Authenticating</dc:identifier>
    <skos:prefLabel xml:lang="en">Authenticating</skos:prefLabel>
    <skos:definition xml:lang="en">Information about authentication and information used for authenticating</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Internal" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#AuthenticationHistory">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>AuthenticationHistory</dc:identifier>
    <skos:prefLabel xml:lang="en">Authentication History</skos:prefLabel>
    <skos:definition xml:lang="en">Information about prior authentication and its outcomes such as login attempts or location</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#Behavioural" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BankAccount">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
