    <skos:broader rdf:resource="https://w3id.org/dpv/pd#BirthPlace" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BirthDate">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>BirthDate</dc:identifier>
