    <skos:definition xml:lang="en">Information about communication metadata in the public sphere</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#PublicLife" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Connection">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Connection</dc:identifier>
