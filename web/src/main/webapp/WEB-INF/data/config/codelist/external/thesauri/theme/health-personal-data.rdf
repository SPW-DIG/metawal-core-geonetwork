  <skos:Concept rdf:about="https://w3id.org/dpv/pd#City">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>City</dc:identifier>
    <skos:prefLabel xml:lang="en">City</skos:prefLabel>
