    <skos:definition xml:lang="en">Information about bank accounts</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#FinancialAccount" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Behavioural">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Behavioural</dc:identifier>
    <skos:prefLabel xml:lang="en">Behavioural</skos:prefLabel>
    <skos:definition xml:lang="en">Information about behaviour or activity</skos:definition>
    <skos:broader rdf:resource="https://w3id.org/dpv/pd#External" />
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#Biometric">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
    <skos:topConceptOf rdf:resource="https://w3id.org/dpv/pd" />
    <dc:identifier>Biometric</dc:identifier>
    <skos:prefLabel xml:lang="en">Biometric</skos:prefLabel>
    <skos:definition xml:lang="en">Information about biometrics and biometric characteristics.</skos:definition>
  </skos:Concept>

  <skos:Concept rdf:about="https://w3id.org/dpv/pd#BirthCountry">
    <skos:inScheme rdf:resource="https://w3id.org/dpv/pd" />
